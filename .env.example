# Copy to .env and replace placeholders. Never commit real credentials.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require"
BREVO_API_KEY="YOUR_BREVO_API_KEY"
# Must be a verified Brevo sender.
MAIL_FROM_EMAIL="hello@yourdomain.com"
MAIL_FROM_NAME="Submitly"
ADMIN_EMAIL="you@example.com"
# scrypt:<32-character hex salt>:<128-character hex hash>; never plaintext.
ADMIN_PASSWORD_HASH=""
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
